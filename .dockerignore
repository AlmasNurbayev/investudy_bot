# Каталоги с подчёркиванием в начале — рабочие, в сборку не идут.
# Прежде всего _volume_db с файлами базы: он принадлежит root, имеет права 0700
# и весит гигабайты, то есть раздул бы контекст сборки и мог её уронить.
_*
**/_*

# Секреты не должны попадать даже в контекст сборки — он целиком уходит демону
# и оседает в слоях промежуточных образов.
.env
*.json

.git
.gitignore
.dockerignore
docker-compose.yml
docker-compose.local.yml

# Конфиг Postgres для стенда: он монтируется в контейнер базы, а не копируется
# в образ с бинарниками.
pg_conf/

# Не нужно для сборки бинарников
.github/
deploy/
docs/
*.md
