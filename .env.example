SPREADSHEET_ID=
SHEET_NAME=
# Ключ сервис-аккаунта — ровно одним способом из двух.
#
# GOOGLE_CREDENTIALS — сам ключ значением: контейнеру тогда не нужен bind-mount
# ради одного файла. Принимается голый JSON в одну строку или его base64;
# base64 надёжнее — в нём нет кавычек и слэшей, которые по дороге через make,
# compose и шелл теряются по-разному:
#     base64 -w0 service-account.json
#
# GOOGLE_CREDENTIALS_FILE — путь к файлу, удобно при запуске на своей машине.
GOOGLE_CREDENTIALS=
GOOGLE_CREDENTIALS_FILE=

# Нижняя граница загрузки в формате листа (ДД.ММ.ГГГГ). Строки с периодом
# раньше этой даты не грузятся вовсе — ни в data, ни в справочники. Пусто или
# не задано — грузить всю историю.
MIN_PERIOD=

# Расписание парсера и чистки истории задаётся кроном, а не переменными:
# оба бинарника одноразовые. Схема чистки — флаг prunedb -scheme.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_TIMEOUT=30s

# REST API (cmd/api). Порт, который слушает API; снаружи его закрывает nginx.
# Обязательный. Тот же номер подставляет compose (deploy/docker-compose.yml)
# в проброс порта, так что менять его нужно только здесь.
API_PORT=8083
# Флаг Secure у cookie сессии. В бою — true (сайт за TLS). false — только для
# локального запуска по http (make dev-api выставляет его сам).
API_COOKIE_SECURE=true

# Токен обязателен и парсеру: о неудачной загрузке он пишет администратору.
TELEGRAM_BOT_TOKEN=
# Telegram-id ЕДИНСТВЕННОГО получателя оповещений парсера (число, не @username).
# Один человек — технический ответственный: только он узнаёт об удачных и
# неудачных загрузках. Пользователи с is_admin в таблице users оповещений НЕ
# получают — список из базы нельзя прочитать, когда упала сама база.
# Этот же id пускается в бота без строки в users.
TELEGRAM_ADMIN_ID=
